{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund --registry=https://registry.npmjs.org/",
  "rewrites": [
    {
      "source": "/manage/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/events/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/draseis/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/articles/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/article/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/articles-embed",
      "destination": "/index.html"
    }
  ]
}
