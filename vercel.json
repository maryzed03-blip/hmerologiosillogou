{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund --registry=https://registry.npmjs.org/",
  "rewrites": [
    {
      "source": "/api/approve-event",
      "destination": "/api/actions?route=approve-event"
    },
    {
      "source": "/api/verify-manage-code",
      "destination": "/api/actions?route=verify-manage-code"
    },
    {
      "source": "/api/send-notification",
      "destination": "/api/actions?route=send-notification"
    },
    {
      "source": "/api/send-friend-request",
      "destination": "/api/actions?route=send-friend-request"
    },
    {
      "source": "/api/newsletter-signup",
      "destination": "/api/site-content?resource=newsletter"
    },
    {
      "source": "/manage/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/events/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/draseis/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/articles/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/article/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/articles-embed",
      "destination": "/index.html"
    }
  ]
}
